    <item>
      <title>C#基础（七）</title>
      <link>https://alone4869.github.io/post/c%23%E5%9F%BA%E7%A1%80%E4%B8%83/</link>
      <pubDate>Sat, 10 Oct 2026 17:18:56 &#43;0800</pubDate>
